# ---------- Go API ----------
PORT=8080
DB_URL=postgres://postgres:postgres@postgres:5432/rss?sslmode=disable
REDIS_ADDR=redis:6379
JWT_SECRET=change-me-to-a-long-random-string
SCRAPE_INTERVAL=1m
MAX_CONCURRENCY=5
DB_QUERY_TIMEOUT=5s

# How the Go API reaches the Python AI service, and the secret they share.
# Generate one with:  openssl rand -hex 32
AI_SERVICE_URL=http://ai-service:8000
AI_SERVICE_TOKEN=change-me-shared-secret
# Longest the API waits for an AI response (the agent can make several LLM calls).
AI_REQUEST_TIMEOUT=60s

# ---------- Python AI service ----------
# Without a key, the reader still works; summaries, Ask, the agent and
# semantic search are simply unavailable.
GEMINI_API_KEY=
# Any model your key can use. This alias tracks Google's current Flash model.
GEMINI_MODEL=gemini-flash-latest
LLM_REQUEST_TIMEOUT=30s

# gemini (default when GEMINI_API_KEY is set) or openai
EMBEDDING_PROVIDER=gemini
EMBEDDING_MODEL=gemini-embedding-001
# Must match the vector(1536) column in sql/schema.
EMBEDDING_DIMENSION=1536
# Optional: separate embedding key (otherwise GEMINI_API_KEY / OPENAI_API_KEY is used)
EMBEDDING_API_KEY=
OPENAI_API_KEY=

# Let the agent's planner pick tools with the LLM instead of keyword rules.
AGENT_LLM_PLANNER=false
